{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "public-route": {
        "ClusterId": "protected-cluster",
        "Match": {
          "Path": "/proxy/public/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/proxy/public" }
        ]
      },
      "secure-route": {
        "ClusterId": "protected-cluster",
        "Match": {
          "Path": "/proxy/secure/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/proxy/secure" }
        ]
      }
    },
    "Clusters": {
      "protected-cluster": {
        "Destinations": {
          "protected-api-destination": {
            "Address": "https+http://protected-api"
          }
        }
      }
    }
  }
}
