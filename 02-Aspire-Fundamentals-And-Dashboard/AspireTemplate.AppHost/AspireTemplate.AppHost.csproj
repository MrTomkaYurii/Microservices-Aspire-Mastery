  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireTemplate.ApiService\AspireTemplate.ApiService.csproj" />
    <ProjectReference Include="..\AspireTemplate.Common\AspireTemplate.Common.csproj" />
    <ProjectReference Include="..\AspireTemplate.Components\RabbitMQConsumers\RabbitMQConsumers.csproj" />
    <ProjectReference Include="..\AspireTemplate.Components\Redis.Cache\Redis.Cache.csproj" />
    <ProjectReference Include="..\AspireTemplate.ServiceDefaults\AspireTemplate.ServiceDefaults.csproj" />
    <ProjectReference Include="..\AspireTemplate.Web\AspireTemplate.Web.csproj" />
  </ItemGroup>

</Project>
